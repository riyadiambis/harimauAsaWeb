## Contoh isi `.env.testing`.
##
## `.env.testing` sendiri masuk .gitignore karena memuat kredensial database.
## Di mesin baru: salin berkas ini jadi `.env.testing`, lalu isi APP_KEY dan
## DB_PASSWORD sesuai mesin masing-masing.
##
##   cp .env.testing.example .env.testing
##   php artisan key:generate --env=testing
##
## phpunit.xml sengaja TIDAK menyetel DB_* — nilai <env> di phpunit menang atas
## dotenv, jadi menyetelnya di sana akan memblokir berkas ini.

APP_NAME="Portal Harimau Asa"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

## APP_TIMEZONE sengaja TIDAK dipasang di sini. Dengan begitu ZonaWaktuTest
## menguji nilai bawaan config/app.php (Asia/Makassar, BR-16) — kalau dipin di
## sini, tes tetap hijau walau konfigurasinya diam-diam kembali ke UTC.

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Database terpisah. migrate:fresh, seeding ulang, dan uji destruktif apa pun
# hanya boleh menyentuh basis data ini — TIDAK PERNAH harimau_asa.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=harimau_asa_test
DB_USERNAME=root
DB_PASSWORD=

# Semuanya diarahkan menjauh dari layanan sungguhan.
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=null

# Bcrypt dipercepat: tes tidak perlu biaya hash produksi.
BCRYPT_ROUNDS=4
